# Copy to ~/n8n/.env on the server and `chmod 600 .env`. Never commit the real file.

# 64 hex chars, generate with: openssl rand -hex 32
# Keep a copy in a password manager: without it, backed-up credentials can't be decrypted.
N8N_ENCRYPTION_KEY=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → (Docker) token
TUNNEL_TOKEN=
